<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="description"
          content="Diagnostic Center Admin Dashboard">

    <title>Diagnostic Admin</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

<div class="app">

    <!-- Login -->
    <section id="loginPage" class="page active">

        <div class="auth-card">

            <div class="brand">
                <div class="brand-icon">+</div>
                <div>
                    <h1>Diagnostic Admin</h1>
                    <p>Secure administration portal</p>
                </div>
            </div>

            <div class="security-badge">
                🔐 Admin 2FA Protected
            </div>

            <form id="loginForm">

                <label for="email">Admin Email</label>
                <input
                    id="email"
                    type="email"
                    placeholder="admin@example.com"
                    autocomplete="username"
                    required
                >

                <label for="password">Password</label>
                <input
                    id="password"
                    type="password"
                    placeholder="Enter password"
                    autocomplete="current-password"
                    required
                >

                <button type="submit" class="primary-btn">
                    Continue
                </button>

            </form>

            <div id="loginMessage" class="message"></div>

            <p class="demo-note">
                Demo UI only — connect this form to your secure backend API
                before production use.
            </p>

        </div>

    </section>


    <!-- 2FA -->
    <section id="twoFactorPage" class="page">

        <div class="auth-card">

            <div class="twofa-icon">🔐</div>

            <h1>Two-Factor Authentication</h1>

            <p>
                Enter the 6-digit code from your authenticator app.
            </p>

            <form id="twoFactorForm">

                <label for="totpCode">Authentication Code</label>

                <input
                    id="totpCode"
                    type="text"
                    inputmode="numeric"
                    pattern="[0-9]{6}"
                    maxlength="6"
                    placeholder="000000"
                    autocomplete="one-time-code"
                    required
                >

                <button type="submit" class="primary-btn">
                    Verify & Login
                </button>

            </form>

            <button id="backToLogin"
                    class="secondary-btn">
                Back to Login
            </button>

            <div id="twoFactorMessage" class="message"></div>

        </div>

    </section>


    <!-- Dashboard -->
    <section id="dashboardPage" class="page">

        <header class="topbar">

            <div class="topbar-brand">
                <div class="brand-icon small">+</div>
                <strong>Diagnostic Admin</strong>
            </div>

            <div class="topbar-right">

                <span class="admin-status">
                    ● Secure
                </span>

                <button id="logoutBtn"
                        class="logout-btn">
                    Logout
                </button>

            </div>

        </header>


        <main class="dashboard">

            <div class="welcome">

                <div>
                    <p class="eyebrow">ADMIN DASHBOARD</p>

                    <h1>Good to see you 👋</h1>

                    <p>
                        Manage your diagnostic center from one place.
                    </p>
                </div>

                <div class="verified">
                    ✓ 2FA Verified
                </div>

            </div>


            <!-- Statistics -->

            <div class="stats-grid">

                <div class="stat-card">
                    <span class="stat-icon">👥</span>
                    <p>Patients</p>
                    <h2 id="patientCount">1,248</h2>
                    <small>Registered patients</small>
                </div>

                <div class="stat-card">
                    <span class="stat-icon">📅</span>
                    <p>Appointments</p>
                    <h2 id="appointmentCount">36</h2>
                    <small>Today's appointments</small>
                </div>

                <div class="stat-card">
                    <span class="stat-icon">🧪</span>
                    <p>Pending Tests</p>
                    <h2 id="testCount">18</h2>
                    <small>Awaiting processing</small>
                </div>

                <div class="stat-card">
                    <span class="stat-icon">📄</span>
                    <p>Reports</p>
                    <h2 id="reportCount">12</h2>
                    <small>Pending reports</small>
                </div>

            </div>


            <!-- Main cards -->

            <div class="content-grid">

                <div class="panel">

                    <div class="panel-header">
                        <div>
                            <h2>Quick Actions</h2>
                            <p>Common administration tasks</p>
                        </div>
                    </div>

                    <div class="actions">

                        <button class="action-btn"
                                data-action="patient">
                            <span>👤</span>
                            <strong>Patients</strong>
                            <small>Manage patients</small>
                        </button>

                        <button class="action-btn"
                                data-action="appointment">
                            <span>📅</span>
                            <strong>Appointments</strong>
                            <small>View appointments</small>
                        </button>

                        <button class="action-btn"
                                data-action="report">
                            <span>📄</span>
                            <strong>Reports</strong>
                            <small>Manage reports</small>
                        </button>

                        <button class="action-btn"
                                data-action="settings">
                            <span>⚙️</span>
                            <strong>Settings</strong>
                            <small>System settings</small>
                        </button>

                    </div>

                </div>


                <div class="panel">

                    <div class="panel-header">
                        <div>
                            <h2>Security</h2>
                            <p>Administrator account status</p>
                        </div>
                    </div>

                    <div class="security-list">

                        <div class="security-row">
                            <span>Password</span>
                            <strong>Protected</strong>
                        </div>

                        <div class="security-row">
                            <span>TOTP 2FA</span>
                            <strong>Enabled</strong>
                        </div>

                        <div class="security-row">
                            <span>Session</span>
                            <strong>Active</strong>
                        </div>

                        <div class="security-row">
                            <span>Access</span>
                            <strong>Administrator</strong>
                        </div>

                    </div>

                </div>

            </div>


            <!-- Activity -->

            <div class="panel activity-panel">

                <div class="panel-header">

                    <div>
                        <h2>Recent Activity</h2>
                        <p>Latest administrative actions</p>
                    </div>

                    <button id="clearActivity"
                            class="text-btn">
                        Clear
                    </button>

                </div>

                <div id="activityList">

                    <div class="activity">
                        <span class="activity-dot"></span>

                        <div>
                            <strong>Admin dashboard opened</strong>
                            <small>Just now</small>
                        </div>
                    </div>

                    <div class="activity">
                        <span class="activity-dot"></span>

                        <div>
                            <strong>2FA verification completed</strong>
                            <small>Today</small>
                        </div>
                    </div>

                </div>

            </div>

        </main>

    </section>

</div>

<script src="app.js"></script>

</body>
</html>
